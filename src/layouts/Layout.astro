---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  canonical?: string;
  jsonLdExtra?: string;
  verificationMeta?: string;
}

const SITE = "https://maxiaramayo.com";
const DEFAULT_TITLE =
  "Maximiliano Aramayo Lazo — Ingeniero en Informática & Fullstack Developer";
const DEFAULT_DESC =
  "Ingeniero en Informática y Fullstack Developer Jr+. Sistemas en producción en salud, retail y servicios: React, Next.js, TypeScript, Node.js, PostgreSQL y Odoo. Del relevamiento al deploy.";
const DEFAULT_OG = `${SITE}/imagenes-perfil/Perfil.jpeg`;

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESC,
  ogImage = DEFAULT_OG,
  ogType = "website",
  canonical = SITE + Astro.url.pathname.replace(/\/$/, "") || SITE,
  jsonLdExtra,
  verificationMeta,
} = Astro.props;

const personLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Maximiliano Aramayo Lazo",
  jobTitle: "Ingeniero en Informática · Fullstack Developer",
  url: SITE,
  email: "maxilazo888@gmail.com",
  image: DEFAULT_OG,
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    credentialCategory: "degree",
    name: "Ingeniería en Informática",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Buenos Aires",
    addressCountry: "AR",
  },
  knowsAbout: [
    "React",
    "TypeScript",
    "Node.js",
    "NestJS",
    "Next.js",
    "PostgreSQL",
    "Odoo",
    "Python",
    "Docker",
    "AWS S3",
    "Firebase",
    "Tailwind CSS",
  ],
  offers: {
    "@type": "Offer",
    description:
      "Desarrollo fullstack y análisis técnico-funcional: relevamiento, arquitectura, desarrollo, integración, implementación de ERP y deploy.",
    areaServed: "Worldwide",
  },
});

const websiteLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Maximiliano Aramayo Lazo — Portfolio",
  url: SITE,
  description: DEFAULT_DESC,
  author: { "@type": "Person", name: "Maximiliano Aramayo Lazo" },
  inLanguage: "es",
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Maximiliano Aramayo Lazo" />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large"
    />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Maximiliano Aramayo Lazo" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@maxiaramayo" />

    <!-- Theme & App -->
    <meta name="theme-color" content="#0b1120" />
    <meta name="color-scheme" content="dark" />
    <meta name="application-name" content="Maximiliano Aramayo Lazo" />
    {
      verificationMeta && (
        <meta name="facebook-domain-verification" content={verificationMeta} />
      )
    }

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Sitemap -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-D1K4WJ4PH0"
    ></script>
    <script>
      const win = window as unknown as {
        dataLayer: unknown[];
        gtag: (...args: unknown[]) => void;
      };
      win.dataLayer = win.dataLayer || [];
      win.gtag = (...args) => {
        win.dataLayer.push(args);
      };
      win.gtag("js", new Date());
      win.gtag("config", "G-D1K4WJ4PH0");
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD: Person + WebSite -->
    <script type="application/ld+json" set:html={personLd} />
    <script type="application/ld+json" set:html={websiteLd} />
    {
      jsonLdExtra && (
        <script type="application/ld+json" set:html={jsonLdExtra} />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/tokens.css";
  @import "../styles/global.css";

  html,
  body {
    min-height: 100%;
    /* `clip` en vez de `hidden`: contiene el desborde horizontal sin
       convertir al root en scroll container, que rompería el sidebar sticky. */
    overflow-x: clip;
  }
</style>
